# Image sources for the connected preparation machine. No runtime credentials.
# Replace every REPLACE value with a tested exact tag/digest, then inspect/pull
# locally before running offline_bundle.py images. Web/Worker must be paired.
NGINX_IMAGE=nginx:REPLACE_TESTED_TAG
POSTGRES_IMAGE=postgres:REPLACE_TESTED_TAG
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:REPLACE_TESTED_TAG
REDIS_IMAGE=redis:REPLACE_TESTED_TAG
# The repository's minio service requires /bin/sh. Distroless is not a drop-in.
MINIO_IMAGE=minio/minio:REPLACE_TESTED_TAG_WITH_SHELL
MINIO_MC_IMAGE=minio/mc:REPLACE_TESTED_TAG
LANGFUSE_WEB_IMAGE=docker.langfuse.com/langfuse/langfuse:REPLACE_PAIRED_VERSION
LANGFUSE_WORKER_IMAGE=docker.langfuse.com/langfuse/langfuse-worker:REPLACE_PAIRED_VERSION
LITELLM_IMAGE=ghcr.io/berriai/litellm:REPLACE_CALLBACK_TESTED_TAG
# Add only when Prometheus/Grafana/DCGM are not reused on existing hosts.
# PROMETHEUS_IMAGE=prom/prometheus:REPLACE_TESTED_TAG
# GRAFANA_IMAGE=grafana/grafana:REPLACE_TESTED_TAG
# DCGM_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:REPLACE_TESTED_TAG

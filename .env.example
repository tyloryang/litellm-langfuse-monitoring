SALT=REPLACE
ENCRYPTION_KEY=REPLACE_64_HEX
NEXTAUTH_SECRET=REPLACE
NEXTAUTH_URL=https://192.168.10.10:8444
LANGFUSE_MEDIA_PUBLIC_ENDPOINT=http://192.168.10.10:9090
LITELLM_MASTER_KEY=sk-REPLACE
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_AFTER_INIT
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_AFTER_INIT
# The custom callback exports directly through Langfuse v4 OTLP.
LANGFUSE_TRACING_ENVIRONMENT=production
# Avoid a second auto-instrumented console exporter; the custom callback owns OTLP.
LITELLM_OTEL_V2=false
# Use the bundled price map in an offline/WSL deployment.
LITELLM_LOCAL_MODEL_COST_MAP=True
# Optional real USD/token prices. Leave absent until accounting is configured.
# GATEWAY_INPUT_COST_PER_TOKEN=0.000001
# GATEWAY_OUTPUT_COST_PER_TOKEN=0.000002
VLLM_API_KEY=REPLACE
SGLANG_API_KEY=REPLACE
STRATA_API_KEY=REPLACE

HOST_IP=192.168.10.10
POSTGRES_IMAGE=postgres:17
# Image acquisition: use verified DDN mirror mapping on connected staging host.
# Do not assume docker.aityp.com is a Docker registry endpoint.
# Preserve canonical tags for offline Compose after docker tag/docker load.
DDN_INDEX_URL=https://docker.aityp.com/
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8
REDIS_IMAGE=redis:7.4
MINIO_IMAGE=minio/minio:REPLACE_TESTED_TAG
MINIO_MC_IMAGE=minio/mc:REPLACE_TESTED_TAG
LANGFUSE_WEB_IMAGE=docker.langfuse.com/langfuse/langfuse:4
LANGFUSE_WORKER_IMAGE=docker.langfuse.com/langfuse/langfuse-worker:4
LITELLM_IMAGE=ghcr.io/berriai/litellm:REPLACE_TESTED_TAG
POSTGRES_PASSWORD=REPLACE
CLICKHOUSE_PASSWORD=REPLACE
REDIS_AUTH=REPLACE
MINIO_USER=langfuseminio
MINIO_PASSWORD=REPLACE
SALT=REPLACE
ENCRYPTION_KEY=REPLACE_64_HEX
NEXTAUTH_SECRET=REPLACE
NEXTAUTH_URL=http://192.168.10.10:3000
LANGFUSE_MEDIA_PUBLIC_ENDPOINT=http://192.168.10.10:9090
LITELLM_MASTER_KEY=sk-REPLACE
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_AFTER_INIT
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_AFTER_INIT
LITELLM_OTEL_V2=true
LITELLM_OTEL_LANGFUSE_SPAN_SCOPE=llm_only
VLLM_API_KEY=REPLACE
SGLANG_API_KEY=REPLACE
STRATA_API_KEY=REPLACE

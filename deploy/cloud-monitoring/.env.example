# Create the private .env and Prometheus token files with prepare.py on the target host.
# The following values are examples, not production credentials.
GRAFANA_ROOT_URL=https://example.invalid:13260/
GRAFANA_HOST_PORT=8802
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_RANDOM_VALUE
NGINX_CERTS_DIR=/path/to/existing/nginx/certs
CLOUD_BACKEND_NETWORK=llm-a100_backend
LITELLM_IMAGE=REPLACE_WITH_EXISTING_LITELLM_IMAGE
NGINX_IMAGE=REPLACE_WITH_EXISTING_NGINX_IMAGE
STRATA_API_KEY=REPLACE_WITH_PRIVATE_STRATA_KEY

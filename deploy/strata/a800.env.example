# Copy to .env on the server, chmod 600, and generate STRATA_API_KEY there.
STRATA_API_KEY=
STRATA_BIND_IP=192.0.2.10
STRATA_PORT=8008

# Start with 32K for the installation smoke test. After it passes, reinstall
# the generated config at 262144 without redownloading the model or MTP.
STRATA_CONTEXT=32768

STRATA_DATA_DIR=/data/qwen-strata/Strata-data
STRATA_MODEL_DIR=/data/qwen-strata/Strata/models/IQ3_XXS
